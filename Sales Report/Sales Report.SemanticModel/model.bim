        "measures": [
          {
            "name": "Total Customer",
            "expression": "COUNT(DimCustomers[Customer_Key])",
            "formatString": "0",
            "lineageTag": "8ea786cc-2c2d-4d5e-b77f-c198c4438ab7"
          },
          {
            "name": "Sum of Profit",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM(FactOrders[Profit])",
            "lineageTag": "db6b3461-a01a-4b21-a2fd-1fb7b168c5e1"
          },
          {
            "name": "Sum of Sales",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM(FactOrders[Sale_Value])",
            "lineageTag": "c246a168-85b3-4a16-9964-0811f5a18e4d"
          },
          {
            "name": "Sum of Quantity",
            "expression": "SUM(FactOrders[Quantity])",
            "formatString": "0",
            "lineageTag": "eb3a146b-e5d6-4e40-8690-0e53b02dac9d"
          },
          {
            "name": "Sum of Order",
            "expression": "COUNT(FactOrders[Order_ID])",
            "formatString": "0",
            "lineageTag": "7a9d613f-bc9f-4661-b3bc-07abbc5b7d86"
          },
          {
            "name": "Average Score",
            "expression": [
              "",
              "VAR TotalScore = SUM(FactOrders[Customer_Satisfaction_Score])",
              "VAR TotalOrderWithScore = CALCULATE(COUNT(FactOrders[Row_ID]), ISBLANK(FactOrders[Customer_Satisfaction_Score]) = FALSE())",
              "",
              "RETURN DIVIDE(TotalScore, TotalOrderWithScore)"
            ],
            "formatString": "0.00",
            "lineageTag": "162f94ad-3540-4903-8e55-0259d2e758e5"
          },
          {
            "name": "Profit Margin",
            "expression": "DIVIDE([Sum of Profit], [Sum of Sales])",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "7aca2550-fa90-45fa-a4c9-7503369d8cd5"
          },
          {
            "name": "Sum of Net Profit",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUMX(FactOrders, FactOrders[Profit] - FactOrders[Shipping_Cost])",
            "lineageTag": "7e386cc4-758f-43ee-868f-efa10b1b20b7"
          },
          {
            "name": "Net Profit Margin",
            "expression": "DIVIDE([Sum of Net Profit], [Sum of Sales])",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "74923736-262f-4db0-8dfd-53bbf0d17aeb"
